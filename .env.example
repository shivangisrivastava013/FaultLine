# FaultLine Environment Configuration

# Database: Leave blank for local SQLite fallback (data/faultline.db) or specify PostgreSQL
DATABASE_URL=sqlite:///data/faultline.db
# DATABASE_URL=postgresql://faultline:faultline_password@localhost:5432/faultline_db

# Prediction API Settings
PREDICTION_API_URL=http://localhost:8000
# ADMIN_API_KEY is REQUIRED for administrative operations (/rollback, /admin/*)
# WARNING: 'faultline_dev_secret_key' is strictly a local development fallback.
# For any deployment outside local development, generate a secure high-entropy secret (e.g., `openssl rand -hex 32`).
ADMIN_API_KEY=faultline_dev_secret_key

# CORS Allowed Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:3000,http://127.0.0.1:3000

# Optional Grounded AI Investigation API Keys (Gemini or OpenAI)
GEMINI_API_KEY=
OPENAI_API_KEY=
