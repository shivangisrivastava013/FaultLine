# FaultLine Environment Configuration

# Database: Leave blank for local SQLite fallback (data/faultline.db) or specify PostgreSQL
DATABASE_URL=sqlite:///data/faultline.db
# DATABASE_URL=postgresql://faultline:faultline_password@localhost:5432/faultline_db

# Prediction API
PREDICTION_API_URL=http://localhost:8000
ADMIN_API_KEY=faultline-secret-key

# Optional LLM Grounded Investigation API Keys
OPENAI_API_KEY=
GEMINI_API_KEY=
